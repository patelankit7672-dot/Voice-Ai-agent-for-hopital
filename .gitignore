# ---- Runtime / mutable demo data ----
# The live booking store holds real names and phone numbers typed during
# testing, so it is NEVER committed. appointments.example.json is the seed a
# fresh clone starts from; the app creates the live file on first write.
data/appointments.json
data/appointments.local.json
logs/
*.log

