# ============================================================
#  Varanasi Hospital AI Voice Assistant — environment template
# ------------------------------------------------------------
#  Copy this file to `.env` and fill in real values.
#      cp .env.example .env
#
#  `.env` is git-ignored. NEVER commit a real key.
#  NEVER paste a real key into this .example file.
# ============================================================

# --- REQUIRED ---------------------------------------------------------------
# Your AssemblyAI API key. Get one at https://www.assemblyai.com/app/api-keys
# This value stays on the server. It is never sent to the browser.
# If a key has ever been pasted into chat, a repo, or a screenshot: ROTATE IT.
ASSEMBLYAI_API_KEY=replace_with_your_rotated_key

# --- Temporary token settings -----------------------------------------------
# How long the browser has to redeem the short-lived token (seconds).
# AssemblyAI allows 1-600. Keep this small: the token is one-time use.
VOICE_TOKEN_EXPIRES_SECONDS=120

# Hard cap on a single voice session (seconds). AssemblyAI allows 60-10800.
VOICE_MAX_SESSION_SECONDS=1800

# --- Voice agent behaviour --------------------------------------------------
# Output voice. Available IDs (see https://www.assemblyai.com/docs/voice-agents/voice-agent-api/voices):
#   American English: alba, eve, george, jane, jean, mary, michael
#   British English : anna, charles, paul, vera
#   Other native    : giovanni (it), lola (es), juergen (de), rafael (pt), estelle (fr)
VOICE_ID=anna

# Speech-recognition languages, comma separated ISO 639-1 codes.
# Leave EMPTY for fully automatic detection across all 18 supported languages.
# "hi,en" constrains to Hindi + English with native code-switching (recommended
# for this demo: it makes Hinglish far more accurate).
VOICE_LANGUAGE_CODES=hi,en

# Hindi speech OUTPUT is not yet available from AssemblyAI (Hindi is supported
# for input/recognition only; native Hindi voices are on their roadmap).
#   true  -> agent REPLIES in Hindi when spoken to in Hindi. Text is correct,
#            but it is spoken by an English-accent voice. Honest + on-spec.
#   false -> agent understands Hindi but replies in simple English.
# See README "Multilingual support — what actually works today".
REPLY_IN_CALLER_LANGUAGE=true

# Agent output volume, 0-100.
VOICE_VOLUME=100

# Optional: bind to a stored agent created via AssemblyAI's REST API instead of
# sending inline session config. Leave EMPTY to use inline config (default, and
# what this MVP is built around).
ASSEMBLYAI_AGENT_ID=

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Comma-separated list of browser origins allowed to call this API.
# Use explicit origins in production. Never use "*" with credentials.
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limit for the token endpoint: max requests per IP per window.
TOKEN_RATE_LIMIT_MAX=10
TOKEN_RATE_LIMIT_WINDOW_SECONDS=60

# Set to "production" to disable verbose error details in API responses.
APP_ENV=development

# ---------------------------------------------------------------------------
# Staff portal (/admin)
# ---------------------------------------------------------------------------
# DEMO-GRADE ACCESS CONTROL. One shared passcode, no per-staff accounts, no
# roles, no audit trail. It keeps the portal from being wide open on a shared
# network; it is not authentication for real patient data.
# Leave ADMIN_PASSCODE empty to switch the staff portal off entirely.
ADMIN_PASSCODE=choose_a_staff_passcode
ADMIN_SESSION_HOURS=8

# ---------------------------------------------------------------------------
# Sarvam AI (Hindi speech)
# ---------------------------------------------------------------------------
# AssemblyAI has no Hindi voice. Sarvam does, so Hindi replies are spoken by
# Sarvam's native Hindi TTS instead of an English voice reading romanised text.
# SERVER-SIDE ONLY. This key must never reach the browser.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_HINDI_SPEAKER=Ritu
